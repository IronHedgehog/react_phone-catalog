{
  "extends": "@mate-academy/students-ts-config",
  "include": ["src"],
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/modules/shared/*"],
      "@store/*": ["src/store/*"],
      "@modules/*": ["src/modules/*"]
    },
    "sourceMap": false,
    "types": ["node", "cypress"],
    "ignoreDeprecations": "6.0"
  }
}
